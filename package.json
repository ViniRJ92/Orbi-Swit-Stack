{
  "name": "orbi-swit-stack",
  "version": "0.33.7",
  "description": "Orbi Swit Stack: hub para centralizar múltiplas contas e serviços web (WhatsApp, Gmail, navegador e mais) em sessões isoladas. Criado por Vinicius Braga.",
  "author": "Vinicius Braga",
  "creator": "Vinicius Braga",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck:main": "tsc -p tsconfig.json --noEmit",
    "build:main": "npm run typecheck:main && node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "watch:main": "tsc -p tsconfig.json --watch",
    "dev:renderer": "vite",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^8.2.2",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.viniciusbraga.orbiswitstack",
    "productName": "Orbi Swit Stack",
    "copyright": "Copyright © 2026 Vinicius Braga",
    "publish": {
      "provider": "github",
      "owner": "ViniRJ92",
      "repo": "Orbi-Swit-Stack"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbi Swit Stack",
      "artifactName": "OrbiSwitStack-Setup-${version}.exe",
      "uninstallDisplayName": "Orbi Swit Stack"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/**/*"
    ]
  }
}
